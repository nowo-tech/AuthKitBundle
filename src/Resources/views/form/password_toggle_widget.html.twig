{#-
  PasswordToggle widget on the UiKit theme slots (default AuthKit form theme after @NowoUiKit/form/nowo_ui_layout
  when NowoPasswordToggleBundle is registered): the password input gets the `input` slot classes like every other
  text widget of the UiKit form theme.
-#}
{% use '@NowoPasswordToggleBundle/Form/toggle_password_widget.html.twig' %}

{%- block toggle_password_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' ' ~ nowo_ui_class('input'))|trim}) -%}
    {{- parent() -}}
{%- endblock toggle_password_widget -%}
