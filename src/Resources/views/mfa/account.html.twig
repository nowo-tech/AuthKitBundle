{#
  Account page of the second factor (1.34, nowo_auth_kit_mfa_account) on the UiKit admin layout. Off: enrolment (QR,
  secret, confirm code). On: status, disable (current code), new recovery codes (current code), trusted devices.
  Variables: mfa_status (MfaStatus), mfa_profile, mfa_enrolment + mfa_enable_form (off; or mfa_sign_in_again minutes +
  mfa_logout_route when the session did not sign in recently, DD-I1), mfa_disable_form +
  mfa_codes_form + mfa_device_forms (on). Override with web_ui.templates.mfa_account (1.37) or the Twig path
  @NowoAuthKitBundle/mfa/account.html.twig. Block nowo_auth_kit_mfa_account_before (1.38): the host's account navigation.
#}
{% extends nowo_ui_layout.admin %}
{% set nowo_ui_bundle = 'NowoAuthKitBundle' %}
{% set _b = 'NowoAuthKitBundle' %}

{% block nowo_ui_document_title %}{{ 'mfa.account.title'|trans({}, _b) }}{% endblock %}

{% block nowo_ui_content %}
    <div class="nowo-auth-kit-mfa-account" data-testid="auth-kit-mfa-account">{% block nowo_auth_kit_mfa_account_before %}{% endblock %}

        <h1 class="{{ nowo_ui_class('page_title', _b) }}">{{ 'mfa.account.title'|trans({}, _b) }}</h1>
        <p class="{{ nowo_ui_class('page_intro', _b) }}">{{ 'mfa.account.intro'|trans({}, _b) }}</p>

        {% if not mfa_status.enabled %}
            <section class="{{ nowo_ui_class('card', _b) }}" aria-labelledby="mfa-enrol-title">
                <header class="{{ nowo_ui_class('card_header', _b) }}"><h2 id="mfa-enrol-title" class="{{ nowo_ui_class('card_title', _b) }}">{{ 'mfa.account.set_up'|trans({}, _b) }}</h2></header>
                <div class="{{ nowo_ui_class('card_body', _b) }}">
                    {% if mfa_status.required %}
                        <p role="status">{{ mfa_status.graceEndsAt ? 'mfa.account.required_until'|trans({'%date%': mfa_status.graceEndsAt|date('Y-m-d')}, _b) : 'mfa.account.required_now'|trans({}, _b) }}</p>
                    {% endif %}
                    {% if mfa_sign_in_again is defined %}
                        <p role="status" data-testid="auth-kit-mfa-sign-in-again">{{ 'mfa.account.sign_in_again'|trans({'%minutes%': mfa_sign_in_again}, _b) }}</p>
                        <p><a href="{{ path(mfa_logout_route, {_csrf_token: csrf_token('logout')}) }}" data-testid="auth-kit-mfa-sign-in-again-link">{{ 'mfa.account.sign_in_again_action'|trans({}, _b) }}</a></p>
                    {% else %}
                        {{ include('@NowoAuthKitBundle/mfa/_enrolment.html.twig', {enrolment: mfa_enrolment}) }}
                        {{ include('@NowoAuthKitBundle/mfa/_code_form.html.twig', {form: mfa_enable_form, submit: 'mfa.account.enable'}) }}
                    {% endif %}
                </div>
            </section>
        {% else %}
            <section class="{{ nowo_ui_class('card', _b) }}" aria-labelledby="mfa-status-title">
                <header class="{{ nowo_ui_class('card_header', _b) }}"><h2 id="mfa-status-title" class="{{ nowo_ui_class('card_title', _b) }}">{{ 'mfa.account.status'|trans({}, _b) }}</h2></header>
                <div class="{{ nowo_ui_class('card_body', _b) }}">
                    <p data-testid="auth-kit-mfa-status">{{ 'mfa.account.status_on'|trans({'%date%': mfa_status.enabledAt ? mfa_status.enabledAt|date('Y-m-d') : ''}, _b) }}</p>
                    <p>{{ 'mfa.account.codes_left'|trans({'%count%': mfa_status.recoveryCodesLeft}, _b) }}{% if mfa_status.recoveryCodesLow() %} <strong>{{ 'mfa.account.codes_low'|trans({}, _b) }}</strong>{% endif %}</p>
                </div>
            </section>
            <section class="{{ nowo_ui_class('card', _b) }}" aria-labelledby="mfa-codes-title">
                <header class="{{ nowo_ui_class('card_header', _b) }}"><h2 id="mfa-codes-title" class="{{ nowo_ui_class('card_title', _b) }}">{{ 'mfa.account.regenerate'|trans({}, _b) }}</h2></header>
                <div class="{{ nowo_ui_class('card_body', _b) }}">
                    <p>{{ 'mfa.account.regenerate_help'|trans({}, _b) }}</p>
                    {{ include('@NowoAuthKitBundle/mfa/_code_form.html.twig', {form: mfa_codes_form, submit: 'mfa.account.regenerate'}) }}
                </div>
            </section>
            <section class="{{ nowo_ui_class('card', _b) }}" aria-labelledby="mfa-devices-title">
                <header class="{{ nowo_ui_class('card_header', _b) }}"><h2 id="mfa-devices-title" class="{{ nowo_ui_class('card_title', _b) }}">{{ 'mfa.account.devices'|trans({}, _b) }}</h2></header>
                <div class="{{ nowo_ui_class('card_body', _b) }}">
                    {% if mfa_status.trustedDevices is empty %}
                        <p>{{ 'mfa.account.devices_none'|trans({}, _b) }}</p>
                    {% else %}
                        <ul class="nowo-auth-kit-mfa__devices" data-testid="auth-kit-mfa-devices">
                            {% for device in mfa_status.trustedDevices %}
                                <li>
                                    {{ device.label }} — {{ 'mfa.account.device_until'|trans({'%date%': device.expires_at|date('Y-m-d')}, _b) }}
                                    {{ form_start(mfa_device_forms[device.public_id], {attr: {class: 'nowo-auth-kit-mfa__inline', 'data-testid': 'auth-kit-mfa-forget'}}) }}
                                        {{ form_widget(mfa_device_forms[device.public_id]) }}
                                        <button type="submit" class="{{ nowo_ui_class('btn_secondary', _b) }}">{{ 'mfa.account.forget'|trans({}, _b) }}<span class="nowo-auth-kit-sr-only"> {{ device.label }}</span></button>
                                    {{ form_end(mfa_device_forms[device.public_id]) }}
                                </li>
                            {% endfor %}
                        </ul>
                        {{ form_start(mfa_device_forms.all, {attr: {'data-testid': 'auth-kit-mfa-forget-all'}}) }}
                            {{ form_widget(mfa_device_forms.all) }}
                            <button type="submit" class="{{ nowo_ui_class('btn_secondary', _b) }}">{{ 'mfa.account.forget_all'|trans({}, _b) }}</button>
                        {{ form_end(mfa_device_forms.all) }}
                    {% endif %}
                </div>
            </section>
            <section class="{{ nowo_ui_class('card', _b) }}" aria-labelledby="mfa-disable-title">
                <header class="{{ nowo_ui_class('card_header', _b) }}"><h2 id="mfa-disable-title" class="{{ nowo_ui_class('card_title', _b) }}">{{ 'mfa.account.disable'|trans({}, _b) }}</h2></header>
                <div class="{{ nowo_ui_class('card_body', _b) }}">
                    <p>{{ (mfa_status.required ? 'mfa.account.disable_required' : 'mfa.account.disable_help')|trans({}, _b) }}</p>
                    {{ include('@NowoAuthKitBundle/mfa/_code_form.html.twig', {form: mfa_disable_form, submit: 'mfa.account.disable', danger: true}) }}
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
