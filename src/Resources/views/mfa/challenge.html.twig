{#
  Second step of a sign-in (1.34, nowo_auth_kit_mfa_challenge): authenticator code, "use a recovery code" (native
  <details>, no JS) and "trust this device". Variables: page (AuthPage with the MfaCodeFormType form), mfa_logout_route.
  @NowoUiKit/page/auth through _auth_page.html.twig.
#}
{% extends '@NowoAuthKitBundle/security/_auth_page.html.twig' %}

{% block nowo_ui_auth_fields %}
    {{ form_errors(form) }}
    {{ form_row(form.code) }}
    {% if form.recovery_code is defined %}
        <details class="nowo-auth-kit-mfa__recovery" data-testid="auth-kit-mfa-recovery"{% if form.recovery_code.vars.errors|length > 0 %} open{% endif %}>
            <summary>{{ 'mfa.challenge.use_recovery'|trans({}, 'NowoAuthKitBundle') }}</summary>
            {{ form_row(form.recovery_code) }}
        </details>
    {% endif %}
    {% if form.trust_device is defined %}{{ form_row(form.trust_device) }}{% endif %}
    {{ form_rest(form) }}
{% endblock %}

{% block nowo_auth_kit_footer_before %}
    <p class="nowo-auth-kit-mfa__signout">
        <a href="{{ path(mfa_logout_route, {_csrf_token: csrf_token('logout')}) }}" data-testid="auth-kit-mfa-signout">{{ 'mfa.challenge.sign_out'|trans({}, 'NowoAuthKitBundle') }}</a>
    </p>
{% endblock %}
