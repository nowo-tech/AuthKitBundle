{#
  Recovery codes shown once (1.34): the list and a download link (data URI built in the browser's page, no request).
  Variable: codes (list of display codes).
#}
<div class="nowo-auth-kit-mfa__codes" data-testid="auth-kit-mfa-codes">
    <p role="alert">{{ 'mfa.recovery.once'|trans({}, 'NowoAuthKitBundle') }}</p>
    <ul class="nowo-auth-kit-mfa__code-list" translate="no">
        {% for code in codes %}<li><code>{{ code }}</code></li>{% endfor %}
    </ul>
    <p>
        <a class="{{ nowo_ui_class('btn_secondary', 'NowoAuthKitBundle') }}" download="recovery-codes.txt" href="data:text/plain;charset=utf-8,{{ codes|join('\r\n')|url_encode }}" data-testid="auth-kit-mfa-codes-download">{{ 'mfa.recovery.download'|trans({}, 'NowoAuthKitBundle') }}</a>
    </p>
</div>
