{#
  QR sign-in approval on the phone (web_ui.templates.qr_login_approve) — @NowoUiKit/page/auth through
  _auth_page.html.twig. Intro = the warning; nowo_ui_auth_fields renders the request details (approve_details:
  list<View\DetailItem>, UiKit detail_list partial) then the approve form fields (hidden token, CSRF, the
  SlideToConfirm control when slide_to_confirm.qr_login_approve is set); nowo_ui_auth_actions the Approve button
  (absent with the slide, which submits the form); the footer the separate Deny form (deny_form, QrLoginDenyType:
  POST to the deny route).
#}
{% extends '@NowoAuthKitBundle/security/_auth_page.html.twig' %}

{% block nowo_ui_auth_fields %}
    {{ form_errors(form) }}
    {% if approve_details|default([]) is not empty %}
        {{ include(nowo_ui_partial('detail_list', page.bundle), {items: approve_details, bundle: page.bundle}) }}
    {% endif %}
    {% for child in form %}
        {% if child.vars.name != 'submit' and not child.rendered %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
{% endblock %}

{% block nowo_ui_auth_actions %}
    {% if form.submit is defined %}
        {{ form_widget(form.submit, {attr: {class: nowo_ui_class('btn_primary', page.bundle)}}) }}
    {% endif %}
{% endblock %}

{% block nowo_auth_kit_footer_before %}
    {{ form_start(deny_form, {action: deny_url|default(null) ?: path(deny_route, {id: challenge_id, t: approve_token}), attr: {class: 'nowo-auth-kit-qr-deny', 'data-nowo-auth-kit-region': 'deny'}}) }}
        <button type="submit" class="{{ nowo_ui_class('btn_danger', page.bundle) }}">{{ 'qr_login.approve.deny'|trans({}, 'NowoAuthKitBundle') }}</button>
    {{ form_end(deny_form) }}
{% endblock %}
