{% extends layout_template %}

{% block title %}{{ 'magic_login.confirm.title'|trans({}, 'NowoAuthKitBundle') }}{% endblock %}

{% block auth_panel %}
<section class="nowo-auth-kit__panel">
    {% block auth_panel_heading %}
    <h1>{{ 'magic_login.confirm.heading'|trans({}, 'NowoAuthKitBundle') }}</h1>
    {% endblock %}
    <p>{{ 'magic_login.confirm.help'|trans({}, 'NowoAuthKitBundle') }}</p>

    {{ form_start(magic_login_confirm_form, {attr: {class: 'nowo-auth-kit__form', 'data-turbo': 'false'}}) }}
        {{ form_widget(magic_login_confirm_form) }}
        <button type="submit" class="{{ nowo_auth_kit_button_class|default('nowo-auth-kit__button') }}">{{ 'magic_login.confirm.submit'|trans({}, 'NowoAuthKitBundle') }}</button>
    {{ form_end(magic_login_confirm_form) }}

    <p class="nowo-auth-kit__footer">
        <a href="{{ path(login_route, auth_kit_route_params()) }}">{{ 'magic_login.confirm.back_to_login'|trans({}, 'NowoAuthKitBundle') }}</a>
    </p>
    {% block auth_footer_extra %}{% endblock %}
</section>
{% endblock %}
