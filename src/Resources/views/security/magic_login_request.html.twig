{% extends layout_template %}

{% block title %}{{ 'magic_login.request.title'|trans({}, 'NowoAuthKitBundle') }}{% endblock %}

{% block body %}
<section class="nowo-auth-kit__panel">
    <h1>{{ 'magic_login.request.heading'|trans({}, 'NowoAuthKitBundle') }}</h1>
    <p>{{ 'magic_login.request.help'|trans({}, 'NowoAuthKitBundle') }}</p>

    {{ form_start(magic_login_form) }}
        {{ form_row(magic_login_form.identifier) }}
        <button type="submit" class="nowo-auth-kit__button">{{ 'magic_login.request.submit'|trans({}, 'NowoAuthKitBundle') }}</button>
    {{ form_end(magic_login_form) }}

    <p class="nowo-auth-kit__footer">
        <a href="{{ path(login_route, auth_kit_route_params()) }}">{{ 'magic_login.request.back_to_login'|trans({}, 'NowoAuthKitBundle') }}</a>
    </p>
</section>
{% endblock %}
