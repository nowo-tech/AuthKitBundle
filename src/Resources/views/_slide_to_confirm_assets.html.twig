{#- SlideToConfirm assets. part: 'styles' | 'scripts' | null (both, 1.x <head> include). -#}
{% if nowo_auth_kit_slide_to_confirm_assets|default(false) %}
{% set _part = part|default(null) %}
{% set _csp_nonce = app is defined and app and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
{% if _part != 'scripts' %}
<link rel="stylesheet" href="{{ asset(nowo_slide_to_confirm_asset_path('slide-to-confirm.css'), nowo_slide_to_confirm_asset_package()) }}">
{% endif %}
{% if _part != 'styles' %}
<script src="{{ asset(nowo_slide_to_confirm_asset_path('slide-to-confirm.js'), nowo_slide_to_confirm_asset_package()) }}" defer{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %}></script>
{% endif %}
{% endif %}
