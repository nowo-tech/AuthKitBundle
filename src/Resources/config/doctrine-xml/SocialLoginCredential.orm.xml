<?xml version="1.0" encoding="UTF-8"?>
<!-- 1.48.0 (doctrine.mapping_type: xml): the same table, columns, indexes and constraints as the attributes of
     SocialLoginCredential. Kept in parity by tests/Unit/Doctrine/XmlMappingParityTest. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\AuthKitBundle\Entity\SocialLoginCredential" table="auth_kit_social_credential" repository-class="Nowo\AuthKitBundle\Repository\SocialLoginCredentialRepository">
        <unique-constraints>
            <unique-constraint name="uniq_auth_kit_social_credential_provider" columns="provider"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="provider" type="string" length="64"/>
        <field name="label" type="string" length="128"/>
        <field name="clientId" column="client_id" type="string" length="255"/>
        <field name="clientSecret" column="client_secret" type="text"/>
        <field name="enabled" type="boolean"/>
        <field name="enterpriseSso" column="enterprise_sso" type="boolean">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="scopes" type="json"/>
        <field name="authorizationParams" column="authorization_params" type="json"/>
        <field name="authorizeUrl" column="authorize_url" type="string" length="512" nullable="true"/>
        <field name="tokenUrl" column="token_url" type="string" length="512" nullable="true"/>
        <field name="userinfoUrl" column="userinfo_url" type="string" length="512" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
