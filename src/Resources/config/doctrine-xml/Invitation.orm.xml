<?xml version="1.0" encoding="UTF-8"?>
<!-- 1.46.0 (doctrine.mapping_type: xml): the same table, columns, indexes and constraints as the attributes of
     Invitation. Kept in parity by tests/Unit/Doctrine/XmlMappingParityTest. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\AuthKitBundle\Entity\Invitation" table="auth_kit_invitation" repository-class="Nowo\AuthKitBundle\Repository\InvitationRepository">
        <indexes>
            <index name="idx_auth_kit_invitation_email" columns="profile,email,accepted_at,revoked_at"/>
            <index name="idx_auth_kit_invitation_expires" columns="expires_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_auth_kit_invitation_public_id" columns="public_id"/>
            <unique-constraint name="uniq_auth_kit_invitation_token" columns="token_hash"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="publicId" column="public_id" type="string" length="32"/>
        <field name="profile" type="string" length="64"/>
        <field name="email" type="string" length="180"/>
        <field name="roles" type="json"/>
        <field name="payload" type="json"/>
        <field name="message" type="text" nullable="true"/>
        <field name="locale" type="string" length="16" nullable="true"/>
        <field name="tokenHash" column="token_hash" type="string" length="64"/>
        <field name="ttlDays" column="ttl_days" type="smallint"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
        <field name="sentAt" column="sent_at" type="datetime_immutable"/>
        <field name="sendCount" column="send_count" type="integer"/>
        <field name="invitedBy" column="invited_by" type="string" length="180" nullable="true"/>
        <field name="lastSentBy" column="last_sent_by" type="string" length="180" nullable="true"/>
        <field name="acceptedAt" column="accepted_at" type="datetime_immutable" nullable="true"/>
        <field name="acceptedBy" column="accepted_by" type="string" length="180" nullable="true"/>
        <field name="revokedAt" column="revoked_at" type="datetime_immutable" nullable="true"/>
        <field name="revokedBy" column="revoked_by" type="string" length="180" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
