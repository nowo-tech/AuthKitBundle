<?xml version="1.0" encoding="UTF-8"?>
<!-- 1.46.0 (doctrine.mapping_type: xml): the same table, columns, indexes and constraints as the attributes of
     MfaCredential. Kept in parity by tests/Unit/Doctrine/XmlMappingParityTest. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\AuthKitBundle\Entity\MfaCredential" table="auth_kit_mfa">
        <unique-constraints>
            <unique-constraint name="uniq_auth_kit_mfa_owner" columns="profile,user_type,user_id"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="totpSecret" column="totp_secret" type="text" nullable="true"/>
        <field name="enabledAt" column="enabled_at" type="datetime_immutable" nullable="true"/>
        <field name="lastUsedStep" column="last_used_step" type="bigint" nullable="true"/>
        <field name="requiredSince" column="required_since" type="datetime_immutable" nullable="true"/>
        <field name="resetAt" column="reset_at" type="datetime_immutable" nullable="true"/>
        <field name="resetBy" column="reset_by" type="string" length="180" nullable="true"/>
        <field name="updatedAt" column="updated_at" type="datetime_immutable"/>
        <field name="profile" type="string" length="64"/>
        <field name="userType" column="user_type" type="string" length="191"/>
        <field name="userId" column="user_id" type="string" length="191"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
