<?xml version="1.0" encoding="UTF-8"?>
<!-- 1.46.0 (doctrine.mapping_type: xml): the same table, columns, indexes and constraints as the attributes of
     MfaTrustedDevice. Kept in parity by tests/Unit/Doctrine/XmlMappingParityTest. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\AuthKitBundle\Entity\MfaTrustedDevice" table="auth_kit_mfa_trusted_device">
        <indexes>
            <index name="idx_auth_kit_mfa_device_mfa" columns="mfa_id,expires_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_auth_kit_mfa_device_public_id" columns="public_id"/>
            <unique-constraint name="uniq_auth_kit_mfa_device_token" columns="token_hash"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="publicId" column="public_id" type="string" length="32"/>
        <field name="mfaId" column="mfa_id" type="integer"/>
        <field name="tokenHash" column="token_hash" type="string" length="64"/>
        <field name="label" type="string" length="64"/>
        <field name="deviceId" column="device_id" type="string" length="64" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="lastUsedAt" column="last_used_at" type="datetime_immutable"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
