<?xml version="1.0" encoding="UTF-8"?>
<!-- 1.46.0 (doctrine.mapping_type: xml): the same table, columns and indexes as the attributes of
     PasswordResetRequest. Kept in parity by tests/Unit/Doctrine/XmlMappingParityTest. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\AuthKitBundle\Entity\PasswordResetRequest" table="auth_kit_password_reset">
        <indexes>
            <index name="idx_auth_kit_password_reset_token" columns="token_hash"/>
            <index name="idx_auth_kit_password_reset_user" columns="user_class,user_id"/>
        </indexes>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="profile" column="profile" type="string" length="64"/>
        <field name="userClass" column="user_class" type="string" length="255"/>
        <field name="userId" column="user_id" type="string" length="191" nullable="true"/>
        <field name="userIdentifier" column="user_identifier" type="string" length="255"/>
        <field name="tokenHash" column="token_hash" type="string" length="64"/>
        <field name="codeHash" column="code_hash" type="string" length="64" nullable="true"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
