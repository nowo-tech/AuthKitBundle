<?xml version="1.0" encoding="UTF-8"?>
<!-- 1.46.0 (doctrine.mapping_type: xml): the same table, columns, indexes and constraints as the attributes of
     AccountVaultEntry. Kept in parity by tests/Unit/Doctrine/XmlMappingParityTest. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\AuthKitBundle\Entity\AccountVaultEntry" table="auth_kit_account_vault">
        <indexes>
            <index name="idx_auth_kit_account_vault_previous" columns="previous_token_hash"/>
            <index name="idx_auth_kit_account_vault_user" columns="profile,user_identifier"/>
            <index name="idx_auth_kit_account_vault_expires" columns="expires_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_auth_kit_account_vault_public_id" columns="public_id"/>
            <unique-constraint name="uniq_auth_kit_account_vault_token" columns="token_hash"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="publicId" column="public_id" type="string" length="32"/>
        <field name="profile" type="string" length="64"/>
        <field name="userIdentifier" column="user_identifier" type="string" length="191"/>
        <field name="tokenHash" column="token_hash" type="string" length="64"/>
        <field name="previousTokenHash" column="previous_token_hash" type="string" length="64" nullable="true"/>
        <field name="rotatedAt" column="rotated_at" type="datetime_immutable"/>
        <field name="sealed" type="text" nullable="true"/>
        <field name="previousSealed" column="previous_sealed" type="text" nullable="true"/>
        <field name="rotatedBy" column="rotated_by" type="string" length="64" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="lastUsedAt" column="last_used_at" type="datetime_immutable"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
