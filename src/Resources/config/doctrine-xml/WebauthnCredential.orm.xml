<?xml version="1.0" encoding="UTF-8"?>
<!-- 2.4.0 (doctrine.mapping_type: xml): the same table, columns, indexes and constraints as the attributes of
     WebauthnCredential. Kept in parity by tests/Unit/Doctrine/XmlMappingParityTest. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\AuthKitBundle\Entity\WebauthnCredential" table="auth_kit_webauthn_credential">
        <indexes>
            <index name="idx_auth_kit_webauthn_owner" columns="profile,user_type,user_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_auth_kit_webauthn_public_id" columns="public_id"/>
            <unique-constraint name="uniq_auth_kit_webauthn_credential" columns="credential_id_hash"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="publicId" column="public_id" type="string" length="32"/>
        <field name="profile" type="string" length="64"/>
        <field name="userType" column="user_type" type="string" length="191"/>
        <field name="userId" column="user_id" type="string" length="191"/>
        <field name="credentialIdHash" column="credential_id_hash" type="string" length="64"/>
        <field name="credentialId" column="credential_id" type="text"/>
        <field name="userHandle" column="user_handle" type="string" length="64"/>
        <field name="publicKey" column="public_key" type="text"/>
        <field name="signCount" column="sign_count" type="bigint"/>
        <field name="transports" type="json"/>
        <field name="aaguid" type="string" length="36" nullable="true"/>
        <field name="backupEligible" column="backup_eligible" type="boolean" nullable="true"/>
        <field name="backupState" column="backup_state" type="boolean" nullable="true"/>
        <field name="label" type="string" length="100"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="lastUsedAt" column="last_used_at" type="datetime_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
