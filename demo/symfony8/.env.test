# PHPUnit / test environment (versioned). Do not commit .env or .env.dev.

# KERNEL_CLASS: PHPUnit kernel bootstrap class.
KERNEL_CLASS='App\Kernel'

# APP_SECRET: fixed secret for deterministic tests.
APP_SECRET=test_secret

# DATABASE_URL: MySQL database of the demo Compose stack (service `mysql`, same DSN as .env.example) used by demo tests.
DATABASE_URL=mysql://demo:demo@mysql:3306/auth_kit_demo?serverVersion=8.0.32&charset=utf8mb4
