<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}"{% block html_attributes %}{% if nowo_ui_theme.hasTokens() %} data-nowo-ui-host-tokens{% endif %}{% endblock %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'demo.home.title'|trans({}, 'demo') }}{% endblock %}</title>
    {#- Demo host CSS (the host's choice; the bundle ships no CDN layout). -#}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    {{ nowo_ui_tokens() }}
    {#- Embedded Account widget (navbar) on every demo page. -#}
    <link rel="stylesheet" href="{{ asset('css/nowo-auth-kit.css', 'nowo_auth_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/demo-auth.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-body-tertiary min-vh-100 d-flex flex-column">
    <nav class="navbar navbar-expand bg-white border-bottom shadow-sm" aria-label="{{ 'demo.home.title'|trans({}, 'demo') }}">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="{{ path('app_welcome', auth_kit_route_params()) }}">{{ 'demo.home.title'|trans({}, 'demo') }}</a>
            <div class="d-flex align-items-center gap-2 ms-auto">
                {% include 'demo/_locale_switcher.html.twig' %}
                {#- the auth pages already show the full form: no second (same-id) form in the navbar -#}
                {% if nowo_ui_page_type|default(null) != 'auth' %}{{ auth_kit_dropdown() }}{% endif %}
            </div>
        </div>
    </nav>
    {% block main %}
    <div class="container py-5 flex-grow-1">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        {% block body %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endblock %}
    {{ include(nowo_ui_partial('scripts')) }}
    {% block javascripts %}{% endblock %}
</body>
</html>
