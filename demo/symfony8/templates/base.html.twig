{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). Bundle pages render through the same shell (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.home.title'|trans({}, 'demo') }}{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {#- Embedded Account widget (masthead) on every demo page. -#}
    <link rel="stylesheet" href="{{ asset('css/nowo-auth-kit.css', 'nowo_auth_kit') }}">
    <link rel="stylesheet" href="{{ asset('bundles/nowopasswordtoggle/css/toggle_password.css') }}">
{% endblock %}

{% block nowo_ui_navigation %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('app_welcome', auth_kit_route_params()) }}">{{ 'demo.home.title'|trans({}, 'demo') }}</a>
        <div class="nowo-ui-header__end">
            {% include 'demo/_locale_switcher.html.twig' %}
            {#- the auth pages already show the full form: no second (same-id) form in the masthead -#}
            {% if nowo_ui_page_type|default(null) != 'auth' %}{{ auth_kit_dropdown() }}{% endif %}
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
