{# Demo-only: last password-reset / magic-login deliveries (no real mailer). #}
{% set deliveries = demo_auth_deliveries() %}
{% if deliveries is not empty %}
    <div class="nowo-ui-flash nowo-ui-flash--info" role="status">
        <p><strong>{{ 'demo.inbox.title'|trans({}, 'demo') }}</strong></p>
        <p class="nowo-ui-muted">{{ 'demo.inbox.help'|trans({}, 'demo') }}</p>
        <ul class="nowo-ui-list">
            {% for item in deliveries|reverse %}
                <li class="nowo-ui-list-item">
                    {% if item.type == 'magic_login' %}
                        <p class="nowo-ui-muted">{{ 'demo.inbox.magic_login'|trans({}, 'demo') }}</p>
                        <p>{{ 'demo.inbox.for'|trans({'%id%': item.masked_identifier}, 'demo') }}</p>
                        <a class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--primary" href="{{ item.login_url }}">{{ 'demo.inbox.open_magic_link'|trans({}, 'demo') }}</a>
                        <p class="nowo-ui-muted"><code class="nowo-ui-code">{{ item.login_url }}</code></p>
                    {% elseif item.type == 'password_reset' %}
                        <p class="nowo-ui-muted">{{ 'demo.inbox.password_reset'|trans({}, 'demo') }}</p>
                        <p>{{ 'demo.inbox.for'|trans({'%id%': item.masked_identifier}, 'demo') }}
                            · {{ 'demo.inbox.delivery'|trans({'%mode%': item.delivery}, 'demo') }}</p>
                        {% if item.reset_url %}
                            <a class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline" href="{{ item.reset_url }}">{{ 'demo.inbox.open_reset_link'|trans({}, 'demo') }}</a>
                            <p class="nowo-ui-muted"><code class="nowo-ui-code">{{ item.reset_url }}</code></p>
                        {% endif %}
                        {% if item.code %}
                            <p>
                                <span>{{ 'demo.inbox.code'|trans({}, 'demo') }}</span>
                                <code class="nowo-ui-code">{{ item.code }}</code>
                            </p>
                        {% endif %}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
